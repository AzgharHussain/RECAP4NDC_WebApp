{
  "info": {
    "name": "RECAP4NDC Incident APIs",
    "_postman_id": "d3f4e5a6-7b8c-4d9e-0f1a-2b3c4d5e6f7a",
    "description": "Complete API collection for Incident Logs, Incident Categories, and Incident Severity Levels. All endpoints require JWT authentication via Authorization header (Bearer token) or authToken cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('base_url')) {",
          "  pm.environment.set('base_url', 'http://localhost:5002');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5002",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "YOUR_JWT_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "incident_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "severity_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Incident Logs",
      "description": "CRUD operations for incident logs with MongoDB image storage. Supports division, range, round, beat, village, and severity level.",
      "item": [
        {
          "name": "Create Incident Log",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}",
                  "type": "text"
                },
                {
                  "key": "incident_type",
                  "value": "Wildlife poaching",
                  "type": "text"
                },
                {
                  "key": "incident_category_id",
                  "value": "1",
                  "type": "text",
                  "description": "Optional: links to incident_categories table"
                },
                {
                  "key": "incident_subcategory",
                  "value": "Suspected poaching",
                  "type": "text",
                  "description": "Optional: subcategory text"
                },
                {
                  "key": "division",
                  "value": "AHM",
                  "type": "text",
                  "description": "Optional: Division name"
                },
                {
                  "key": "range_name",
                  "value": "North Range",
                  "type": "text",
                  "description": "Optional: Range name"
                },
                {
                  "key": "round",
                  "value": "Round 1",
                  "type": "text",
                  "description": "Optional: Round name"
                },
                {
                  "key": "beat",
                  "value": "Beat 5",
                  "type": "text",
                  "description": "Optional: Beat name"
                },
                {
                  "key": "village",
                  "value": "Sample Village",
                  "type": "text",
                  "description": "Optional: Village name"
                },
                {
                  "key": "severity_id",
                  "value": "1",
                  "type": "text",
                  "description": "Optional: links to incident_severity_levels table (1=Critical, 2=High, 3=Medium, 4=Low)"
                },
                {
                  "key": "incident_date",
                  "value": "2026-09-08",
                  "type": "text"
                },
                {
                  "key": "incident_time",
                  "value": "14:30",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Forest fire detected near beat 3",
                  "type": "text"
                },
                {
                  "key": "incident_image",
                  "type": "file",
                  "src": "",
                  "description": "Optional image file (JPG, PNG, GIF, HEIC)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/incident-logs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-logs"
              ]
            },
            "description": "Create a new incident log. Accepts multipart/form-data. Image is stored in MongoDB with sourceType='incident'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.incident_id) {",
                  "  pm.environment.set('incident_id', res.data.incident_id);",
                  "  console.log('Saved incident_id: ' + res.data.incident_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Incident Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/incident-logs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-logs"
              ]
            },
            "description": "Fetch all incident logs with images from MongoDB, category name, and severity level. Ordered by created_at DESC."
          }
        },
        {
          "name": "Get Incident Logs by User ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/incident-logs/user/{{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-logs",
                "user",
                "{{user_id}}"
              ]
            },
            "description": "Fetch all incident logs for a specific user_id. Includes images, category name, and severity level."
          }
        },
        {
          "name": "Get Single Incident Log",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/incident-logs/{{incident_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-logs",
                "{{incident_id}}"
              ]
            },
            "description": "Fetch a single incident log by incident_id. Includes image, category name, and severity level."
          }
        },
        {
          "name": "Update Incident Log",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "incident_type",
                  "value": "Fire",
                  "type": "text",
                  "description": "Optional"
                },
                {
                  "key": "incident_category_id",
                  "value": "2",
                  "type": "text",
                  "description": "Optional"
                },
                {
                  "key": "incident_subcategory",
                  "value": "Active forest fire",
                  "type": "text",
                  "description": "Optional"
                },
                {
                  "key": "division",
                  "value": "AHM",
                  "type": "text",
                  "description": "Optional"
                },
                {
                  "key": "range_name",
                  "value": "South Range",
                  "type": "text",
                  "description": "Optional"
                },
                {
                  "key": "round",
                  "value": "Round 2",
                  "type": "text",
                  "description": "Optional"
                },
                {
                  "key": "beat",
                  "value": "Beat 3",
                  "type": "text",
                  "description": "Optional"
                },
                {
                  "key": "village",
                  "value": "Updated Village",
                  "type": "text",
                  "description": "Optional"
                },
                {
                  "key": "severity_id",
                  "value": "2",
                  "type": "text",
                  "description": "Optional: 1=Critical, 2=High, 3=Medium, 4=Low"
                },
                {
                  "key": "incident_date",
                  "value": "2026-09-09",
                  "type": "text",
                  "description": "Optional"
                },
                {
                  "key": "incident_time",
                  "value": "15:45",
                  "type": "text",
                  "description": "Optional"
                },
                {
                  "key": "description",
                  "value": "Updated description",
                  "type": "text",
                  "description": "Optional"
                },
                {
                  "key": "incident_image",
                  "type": "file",
                  "src": "",
                  "description": "Optional new image (replaces old)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/incident-logs/{{incident_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-logs",
                "{{incident_id}}"
              ]
            },
            "description": "Update an incident log. All fields are optional — only sent fields are updated. New image replaces old one in MongoDB."
          }
        },
        {
          "name": "Delete Incident Log",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/incident-logs/{{incident_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-logs",
                "{{incident_id}}"
              ]
            },
            "description": "Delete an incident log by incident_id. Also deletes its image from MongoDB."
          }
        }
      ]
    },
    {
      "name": "Incident Categories",
      "description": "Lookup table for incident categories and subcategories. Seeded automatically on server start with 13 categories from the Incident Categories document.",
      "item": [
        {
          "name": "Get All Categories (Nested)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/incident-categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-categories"
              ]
            },
            "description": "Fetch all categories with their subcategories nested. Used for dropdowns and frontend display."
          }
        },
        {
          "name": "Get All Categories (Flat)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/incident-categories/flat",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-categories",
                "flat"
              ]
            },
            "description": "Fetch a flat list of categories only (no subcategories). For simple dropdowns."
          }
        },
        {
          "name": "Get Subcategories by Category ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/incident-categories/{{category_id}}/subcategories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-categories",
                "{{category_id}}",
                "subcategories"
              ]
            },
            "description": "Fetch subcategories for a specific category. Used for dependent/cascading dropdowns."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.category && res.category.category_id) {",
                  "  pm.environment.set('category_id', res.category.category_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_name\": \"New Category\",\n  \"subcategories\": [\n    \"Subcategory 1\",\n    \"Subcategory 2\",\n    \"Subcategory 3\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/incident-categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-categories"
              ]
            },
            "description": "Create a new category. Optionally include a subcategories array of strings."
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_name\": \"Updated Category Name\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/incident-categories/{{category_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-categories",
                "{{category_id}}"
              ]
            },
            "description": "Update a category name."
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/incident-categories/{{category_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-categories",
                "{{category_id}}"
              ]
            },
            "description": "Delete a category and all its subcategories (cascade delete)."
          }
        }
      ]
    },
    {
      "name": "Incident Severity Levels",
      "description": "Lookup table for incident severity levels. Seeded automatically on server start with 4 levels: Critical, High, Medium, Low.",
      "item": [
        {
          "name": "Get All Severity Levels",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/incident-severity",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-severity"
              ]
            },
            "description": "Fetch all severity levels ordered by display_order. Returns severity_id, level_name, display_order, and color_code."
          }
        },
        {
          "name": "Create Severity Level",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"level_name\": \"Very Low\",\n  \"display_order\": 5,\n  \"color_code\": \"#22c55e\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/incident-severity",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-severity"
              ]
            },
            "description": "Create a new severity level. level_name is required; display_order and color_code are optional."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.severity_id) {",
                  "  pm.environment.set('severity_id', res.data.severity_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Severity Level",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"level_name\": \"Critical\",\n  \"display_order\": 1,\n  \"color_code\": \"#dc2626\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/incident-severity/{{severity_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-severity",
                "{{severity_id}}"
              ]
            },
            "description": "Update a severity level. All fields are optional — only sent fields are updated."
          }
        },
        {
          "name": "Delete Severity Level",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/incident-severity/{{severity_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "incident-severity",
                "{{severity_id}}"
              ]
            },
            "description": "Delete a severity level by severity_id."
          }
        }
      ]
    }
  ]
}