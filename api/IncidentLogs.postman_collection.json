{
  "info": {
    "name": "Incident Logs API",
    "_postman_id": "b1c2d3e4-5f60-4a7b-8c9d-0e1f2a3b4c5d",
    "description": "CRUD API for incident logs with image storage in MongoDB. All endpoints require JWT authentication via Authorization header (Bearer token) or authToken cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('base_url')) {",
          "  pm.environment.set('base_url', 'http://localhost:5002');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5002",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "YOUR_JWT_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "incident_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Incident Log",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "user_id",
              "value": "{{user_id}}",
              "type": "text"
            },
            {
              "key": "incident_type",
              "value": "Fire",
              "type": "text"
            },
            {
              "key": "incident_date",
              "value": "2026-09-08",
              "type": "text"
            },
            {
              "key": "incident_time",
              "value": "14:30",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Forest fire detected near beat 3",
              "type": "text"
            },
            {
              "key": "incident_image",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/incident-logs",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "incident-logs"
          ]
        },
        "description": "Create a new incident log. Accepts multipart/form-data with text fields and an optional image file (incident_image). Image is stored in MongoDB."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var res = pm.response.json();",
              "if (res.data && res.data.incident_id) {",
              "  pm.environment.set('incident_id', res.data.incident_id);",
              "  console.log('Saved incident_id: ' + res.data.incident_id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get All Incident Logs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/incident-logs",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "incident-logs"
          ]
        },
        "description": "Fetch all incident logs with their associated images from MongoDB. Ordered by created_at DESC."
      }
    },
    {
      "name": "Get Incident Logs by User ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/incident-logs/user/{{user_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "incident-logs",
            "user",
            "{{user_id}}"
          ]
        },
        "description": "Fetch all incident logs for a specific user_id. Includes images from MongoDB."
      }
    },
    {
      "name": "Get Single Incident Log",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/incident-logs/{{incident_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "incident-logs",
            "{{incident_id}}"
          ]
        },
        "description": "Fetch a single incident log by incident_id. Includes its image from MongoDB."
      }
    },
    {
      "name": "Update Incident Log",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "incident_type",
              "value": "Poaching",
              "type": "text"
            },
            {
              "key": "incident_date",
              "value": "2026-09-08",
              "type": "text"
            },
            {
              "key": "incident_time",
              "value": "15:45",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Updated description: poaching incident reported",
              "type": "text"
            },
            {
              "key": "incident_image",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/incident-logs/{{incident_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "incident-logs",
            "{{incident_id}}"
          ]
        },
        "description": "Update an existing incident log. All fields are optional. If a new incident_image file is uploaded, the old image in MongoDB is replaced."
      }
    },
    {
      "name": "Delete Incident Log",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/incident-logs/{{incident_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "incident-logs",
            "{{incident_id}}"
          ]
        },
        "description": "Delete an incident log by incident_id. Also deletes its associated image from MongoDB."
      }
    }
  ]
}